{
  "info": {
    "name": "Taller Redes - Equipo 20 - Servicio de Envíos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "equipo", "value": "CIAF-20" }
  ],
  "item": [
    {
      "name": "1. GET válido (200)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-Red-Equipo", "value": "{{equipo}}" },
          { "key": "Origin", "value": "http://localhost:5500" }
        ],
        "url": "{{baseUrl}}/api/recurso"
      }
    },
    {
      "name": "2. POST válido (201)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Red-Equipo", "value": "{{equipo}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"guia\": \"ENV-003\",\n  \"destino\": \"Cali\",\n  \"estado\": \"En bodega\"\n}" },
        "url": "{{baseUrl}}/api/recurso"
      }
    },
    {
      "name": "3. GET sin encabezado (401)",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/recurso" }
    },
    {
      "name": "4. POST con encabezado incorrecto (401)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Red-Equipo", "value": "CIAF-999" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{ \"guia\": \"ENV-004\", \"destino\": \"Bogotá\" }" },
        "url": "{{baseUrl}}/api/recurso"
      }
    },
    {
      "name": "5. Verificación de encabezados de respuesta",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('Código 200', () => pm.response.to.have.status(200));",
          "pm.test('X-Servidor-Procesado correcto', () => pm.response.to.have.header('X-Servidor-Procesado', 'Equipo-20'));",
          "pm.test('CORS devuelve el origen permitido', () => pm.response.to.have.header('Access-Control-Allow-Origin', 'http://localhost:5500'));"
        ]}
      }],
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-Red-Equipo", "value": "{{equipo}}" },
          { "key": "Origin", "value": "http://localhost:5500" }
        ],
        "url": "{{baseUrl}}/api/recurso"
      }
    }
  ]
}
